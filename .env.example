# Copy to .env.local for `vercel dev`, or set in Vercel Project → Settings → Environment Variables.
# Easiest: Vercel Dashboard → Storage → Create KV (Upstash) → connect to this project.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Or plain Upstash (same thing):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
